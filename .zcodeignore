.env
data/
outputs/
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
.DS_Store
*.sqlite3
.vercel
.pnpm-store/
.freebuff/
supabase/.temp/
web/.vercel
web/node_modules/
# root-level node_modules — stray artifacts (e.g. temporary diagnostic tools)
node_modules/
web/dist/
scratch/
vercel_deploy.log

# codeops: per-patch file backups written before an approved patch lands
.codeops_backups/

# secrets — never commit
.env
.env.*
!.env.example
# Exception: the dashboard's *publishable* Supabase values. An anon key is
# shipped to every browser by design (RLS is what protects the data), and the
# build needs it in every mode — dev and production — so it lives in ONE
# tracked file instead of being duplicated in source and per-mode env files.
!web/.env
*.bootstrap

# pytest coverage artifact
.coverage

# ephemeral local secret material (never commit)
*.secret_tmp

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
