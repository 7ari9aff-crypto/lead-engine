# ============================================================
# Lead Engine - API Keys
# انسخ الملف ده باسم .env وحتّ المفاتيح. .env مش بيترفع على git.
# أي مفتاح مش موجود = الـprovider بيتشاف unavailable والـrouter
# بيلفّ على اللي بعده تلقائيًا.
# ============================================================

# --- Search pool (ترتيب الأولوية) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# --- LLM pool (ترتيب: Gemini -> Groq -> OpenRouter -> Ollama local) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama مش محتاج مفتاح، بس محتاج السيرفر شغال محليًا:
OLLAMA_BASE_URL=http://localhost:11434

# --- People / Company data ---
APOLLO_API_KEY=

# --- Email find / verify ---
HUNTER_API_KEY=
ABSTRACT_API_KEY=

# --- Supabase (قاعدة بيانات الـleads) ---
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- n8n (اختياري: لو عايز الـengine ينادي workflows) ---
N8N_BASE_URL=
N8N_MCP_BEARER=

# --- GitHub (متجابه في أي ملف داخل المشروع) ---
# GITHUB_TOKEN=
