# ============================================================
# Lead Engine - API Keys (PRODUCTION)
# انسخ الملف ده باسم .env وحطّ المفاتيح. .env مش بيترفع على git.
# كل التشغيلات حقيقية — أي مفتاح مش موجود = الـprovider بيتشاف
# unavailable والـrouter بيلفّ على اللي بعده تلقائيًا.
# لو SUPABASE_URL + SUPABASE_SERVICE_KEY موجودين، كل تشغيل ناجح
# بيتزامن تلقائيًا مع قاعدة Supabase.
# ============================================================

# --- OpenManus Deep-Browsing Runtime (Port 8600) ---
# Bridge runs on the OpenManus machine. Documented in docs/openmanus-contract.md
OPENMANUS_BASE_URL=http://localhost:8600
# Generate a random secret token (e.g. openssl rand -hex 24).
# MUST match OPENMANUS_WRAPPER_TOKEN on the OpenManus host. Never commit real secrets.
OPENMANUS_TOKEN=

# --- Search pool (ترتيب الأولوية) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# --- LLM pool (ترتيب: Gemini -> Groq -> OpenRouter -> Ollama local) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama مش محتاج مفتاح، بس محتاج السيرفر شغال محليًا:
OLLAMA_BASE_URL=http://localhost:11434

# --- People / Company data ---
APOLLO_API_KEY=

# --- Email find / verify ---
HUNTER_API_KEY=
ABSTRACT_API_KEY=

# --- Supabase (قاعدة بيانات الـleads + المزامنة التلقائية) ---
# Project Settings -> API
SUPABASE_URL=https://abshiqxxsvdtbdngycpb.supabase.co
SUPABASE_SERVICE_KEY=

# --- n8n (اختياري: لو عايز الـengine ينادي workflows) ---
N8N_BASE_URL=
N8N_MCP_BEARER=

# --- Control plane authentication ---
LEAD_ENGINE_ADMIN_PASSWORD=
LEAD_ENGINE_AUTH_SECRET=
LEAD_ENGINE_COOKIE_SECURE=1
# Comma-separated browser origins. Keep explicit; do not use '*'.
# In development, unset uses localhost:3000/5173 defaults. In production,
# set this explicitly when a separate frontend origin needs API access.
LEAD_ENGINE_CORS_ORIGINS=
LEAD_ENGINE_ENV=production

# --- Optional readiness / deployment settings ---
# LEAD_ENGINE_DATA_DIR=/app/data
# LEAD_ENGINE_OUTPUTS_DIR=/app/outputs

# --- GitHub ---
# GITHUB_TOKEN=

# ============================================================
# Ops variables the engine reads (kept in one place).
# ⚠️ الأسماء دي بتتقري من الكود فعلاً — مش اختيارية توثيقًا.
# ============================================================

# --- Database backend (PRODUCTION) ---
# Postgres DSN (Supabase: Project Settings -> Database -> Connection string).
# When set, the engine runs on Postgres (multi-tenant, RLS). Empty = local
# SQLite (dev/tests only). SUPABASE_DB_URL wins over DATABASE_URL.
SUPABASE_DB_URL=
# DATABASE_URL=

# --- Supabase Auth (control plane) ---
# Legacy HS256 projects only (modern Supabase uses JWKS via SUPABASE_URL).
# SUPABASE_JWT_SECRET=

# --- Tenant / platform ---
# Single-org bridge for machine contexts (worker, n8n, MCP): the org every
# token-less request belongs to. Browser requests resolve the org from the
# verified JWT membership instead.
# LEAD_ENGINE_ORG_ID=
# Static bearer token for machine clients (n8n scheduler / MCP / workers).
# Generate: openssl rand -hex 24
# LEAD_ENGINE_MCP_TOKEN=
# AES-256-GCM key for org provider credentials at rest (urlsafe base64, 32B).
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# LEAD_ENGINE_ENCRYPTION_KEY=
# Control plane's control plane (provisioning API): PLATFORM_ADMIN_TOKEN=
# Public origin used to build OAuth redirect URIs: LEAD_ENGINE_PUBLIC_BASE_URL=
# Fail instead of warn when the DB role has BYPASSRLS (hardening): LEAD_ENGINE_REQUIRE_NOBYPASSRLS=1

# --- Job queue mode ---
# worker  → a `python -m lead_engine worker` fleet leases jobs (long runs)
# inline  → jobs execute in-process (serverless default)
# unset   → inline, even when Postgres is configured
# LEAD_ENGINE_QUEUE_MODE=inline

# --- Rate limiting (in-process token bucket) ---
# LEAD_ENGINE_RATE_LIMIT=1
# LEAD_ENGINE_RATE_LIMIT_RPS=8
# LEAD_ENGINE_RATE_LIMIT_BURST=40

# --- Email notifications (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_NOTIFY_TO=

# --- OpenManus deep-browsing runtime (host-side, not the engine) ---
# OPENMANUS_CWD=
# OPENMANUS_ENTRY=
# OPENMANUS_TASKS_DIR=
# OPENMANUS_WRAPPER_TOKEN=

# --- Local/dev switches (never set in production) ---
# LEAD_ENGINE_DEV_OPEN=1        # run the control plane open (ignored in production)
# LEAD_ENGINE_DATA_DIR=/app/data
# LEAD_ENGINE_OUTPUTS_DIR=/app/outputs
# LOG_LEVEL=INFO
# LOG_FORMAT=json
