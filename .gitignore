.env
data/
outputs/
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
.DS_Store
*.sqlite3
.vercel
.pnpm-store/
.freebuff/
supabase/.temp/
web/.vercel
web/node_modules/
# root-level node_modules — stray artifacts (e.g. temporary diagnostic tools)
node_modules/
web/dist/
scratch/
vercel_deploy.log

# codeops: per-patch file backups written before an approved patch lands
.codeops_backups/

# secrets — never commit
.env
.env.*
!.env.example
# Exception: the dashboard's *publishable* Supabase values. An anon key is
# shipped to every browser by design (RLS is what protects the data), and the
# build needs it in every mode — dev and production — so it lives in ONE
# tracked file instead of being duplicated in source and per-mode env files.
!web/.env
*.bootstrap

# pytest coverage artifact
.coverage

# ephemeral local secret material (never commit)
*.secret_tmp
